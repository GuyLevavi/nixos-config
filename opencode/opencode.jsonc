{
  "$schema": "https://opencode.ai/config.json",
  // Language servers. The binaries are supplied on PATH by home/lsp.nix — the
  // one declaration routed to zed, opencode and nvim — so each `command` is
  // just a name. `pyright` is off in favour of basedpyright (the nix build) so
  // opencode never downloads a language server at runtime. Servers whose id
  // matches an opencode built-in (nixd, bash, yaml-ls, clangd) reuse its
  // extension set; the rest declare their own.
  "lsp": {
    "pyright": { "disabled": true },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "nixd": { "command": ["nixd"] },
    "bash": { "command": ["bash-language-server", "start"] },
    "yaml-ls": { "command": ["yaml-language-server", "--stdio"] },
    "clangd": { "command": ["clangd", "--background-index", "--clang-tidy"] },
    "taplo": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    },
    "package-version-server": {
      "command": ["package-version-server"],
      "extensions": [".json"]
    },
    "markdown-oxide": {
      "command": ["markdown-oxide"],
      "extensions": [".md", ".markdown"]
    }
  }
}
